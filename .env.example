# PostgreSQL connection string (required)
# Local example: postgresql://postgres:postgres@localhost:5432/abuja_food_fest
# Neon / Supabase / Railway: paste the provided URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/abuja_food_fest

# Set to true when using managed Postgres that requires SSL (Neon, Railway, etc.)
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Admin session signing secret — change in production
AUTH_SECRET=abuja-food-fest-dev-secret-change-me

# Paystack (optional — orders work without keys; status stays "pending")
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Optional later:
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
